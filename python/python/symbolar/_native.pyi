from typing import Generic, TypeVar

import numpy as np
import numpy.typing as npt
import polars as pl

_V = TypeVar("_V", bound=Vector)
_U = TypeVar("_U", bound=Vector)
_S = TypeVar("_S", bound=Storage)
_E = TypeVar("_E")

class VSA:
    def architecture(self) -> str: ...
    def create_storage(self, num_elements: int) -> Storage: ...

class Vector:
    def architecture(self) -> str: ...
    def size(self) -> int: ...

class Storage:
    def architecture(self) -> str: ...
    def size(self) -> int: ...

class _Architecture(VSA, Generic[_V, _S, _E]):
    def __init__(self, seed: int) -> None: ...
    def seed(self) -> int: ...
    def random_vector(self, size: int) -> _V: ...
    def create_storage(self, num_elements: int) -> _S: ...
    def create_encoder(self, spec: str) -> _E: ...
    def vector_from_numpy(self, dense: npt.NDArray[np.float32]) -> _V: ...

class _Vector(Vector, Generic[_V, _U]):
    def similarity(self, other: _V) -> float: ...
    def permute(self, shifts: int) -> _V: ...
    def bind(self, other: _V) -> _V: ...
    def bundle(self, other: _V) -> _V: ...
    def bundle_unnormalized(self, other: _V) -> _U: ...
    def equals(self, other: _V) -> bool: ...
    def to_list(self) -> list[float]: ...
    def __mul__(self, other: _V) -> _V: ...
    def __add__(self, other: _V) -> _V: ...

class _UnnormalizedVector(Vector, Generic[_V, _U]):
    def normalize(self) -> _V: ...
    def similarity(self, other: _U) -> float: ...
    def best_match(self, candidates: dict[str, _U]) -> str | None: ...
    def bind(self, other: _V) -> _U: ...
    def bundle(self, other: _V) -> _U: ...
    def equals(self, other: _U) -> bool: ...
    def to_list(self) -> list[float]: ...
    def __mul__(self, other: _V) -> _U: ...
    def __add__(self, other: _V) -> _U: ...

class _Storage(Storage, Generic[_V, _U]):
    def push(self, name: str) -> None: ...
    def extend(self, names: list[str]) -> None: ...
    def columns(self) -> list[str]: ...
    def values(self) -> list[str]: ...
    def get(self, name: str) -> _V | None: ...
    def get_column_value(self, column: str, value: str) -> _V | None: ...
    def execute(self, expression: str) -> _V: ...
    def find(self, vector: _V) -> _V | None: ...

class _Subset(Generic[_V, _U]):
    def bundle_rows(self) -> list[_V | None]: ...
    def bundle_rows_unnormalized(self) -> list[_U | None]: ...
    def bundle_dataset(self) -> _V | None: ...
    def bundle_dataset_unnormalized(self) -> _U | None: ...
    def bundle_dataset_combinatorial(self, ways: int) -> _U | None: ...
    def bundle_dataset_temporal(self) -> _V | None: ...
    def bundle_dataset_temporal_unnormalized(self) -> _U | None: ...
    def bundle_dataset_temporal_grouped(self, groups: list[int]) -> dict[int, _U]: ...
    def bind_dataset(self) -> _V | None: ...

class _Encoder(Generic[_V]):
    def size(self) -> int: ...
    def symbols(self) -> list[str]: ...
    def digest(self) -> str: ...
    def encode(self, codes: pl.DataFrame, normalize: bool = True, dtype: str = "float32") -> np.ndarray: ...
    def labels(self, variable: str) -> list[str]: ...
    def keys(self, variable: str) -> npt.NDArray[np.float32]: ...
    def continuous_keys(self, variable: str, values: list[float]) -> npt.NDArray[np.float32]: ...
    def evaluate(self, expression: str) -> npt.NDArray[np.float32]: ...
    def evaluate_vector(self, expression: str) -> _V: ...
    def get(self, name: str) -> _V | None: ...
    def random(self, name: str, count: int) -> npt.NDArray[np.float32]: ...

class BscVector(_Vector[BscVector, BscUnnormalizedVector]): ...
class BscUnnormalizedVector(_UnnormalizedVector[BscVector, BscUnnormalizedVector]): ...
class BscStorage(_Storage[BscVector, BscUnnormalizedVector]):
    def __init__(self, architecture: BinarySpatterCode, size: int) -> None: ...
    @staticmethod
    def from_dataframe(architecture: BinarySpatterCode, size: int, dataframe: pl.DataFrame) -> BscStorage: ...
    def subset(self, dataframe: pl.DataFrame) -> BscSubset: ...
class BscSubset(_Subset[BscVector, BscUnnormalizedVector]): ...
class BscEncoder(_Encoder[BscVector]): ...
class BinarySpatterCode(_Architecture[BscVector, BscStorage, BscEncoder]): ...

class MapVector(_Vector[MapVector, MapUnnormalizedVector]): ...
class MapUnnormalizedVector(_UnnormalizedVector[MapVector, MapUnnormalizedVector]): ...
class MapStorage(_Storage[MapVector, MapUnnormalizedVector]):
    def __init__(self, architecture: MultiplyAddPermute, size: int) -> None: ...
    @staticmethod
    def from_dataframe(architecture: MultiplyAddPermute, size: int, dataframe: pl.DataFrame) -> MapStorage: ...
    def subset(self, dataframe: pl.DataFrame) -> MapSubset: ...
class MapSubset(_Subset[MapVector, MapUnnormalizedVector]): ...
class MapEncoder(_Encoder[MapVector]): ...
class MultiplyAddPermute(_Architecture[MapVector, MapStorage, MapEncoder]): ...

class HrrVector(_Vector[HrrVector, HrrUnnormalizedVector]):
    def inverse(self) -> HrrVector: ...
    def __neg__(self) -> HrrVector: ...
class HrrUnnormalizedVector(_UnnormalizedVector[HrrVector, HrrUnnormalizedVector]): ...
class HrrStorage(_Storage[HrrVector, HrrUnnormalizedVector]):
    def __init__(self, architecture: HolographicReducedRepresentation, size: int) -> None: ...
    @staticmethod
    def from_dataframe(
        architecture: HolographicReducedRepresentation, size: int, dataframe: pl.DataFrame
    ) -> HrrStorage: ...
    def subset(self, dataframe: pl.DataFrame) -> HrrSubset: ...
class HrrSubset(_Subset[HrrVector, HrrUnnormalizedVector]): ...
class HrrEncoder(_Encoder[HrrVector]): ...
class HolographicReducedRepresentation(_Architecture[HrrVector, HrrStorage, HrrEncoder]): ...

class VtbVector(_Vector[VtbVector, VtbUnnormalizedVector]):
    def inverse(self) -> VtbVector: ...
    def __neg__(self) -> VtbVector: ...
class VtbUnnormalizedVector(_UnnormalizedVector[VtbVector, VtbUnnormalizedVector]): ...
class VtbStorage(_Storage[VtbVector, VtbUnnormalizedVector]):
    def __init__(self, architecture: VectorDerivedTransformationBinding, size: int) -> None: ...
    @staticmethod
    def from_dataframe(
        architecture: VectorDerivedTransformationBinding, size: int, dataframe: pl.DataFrame
    ) -> VtbStorage: ...
    def subset(self, dataframe: pl.DataFrame) -> VtbSubset: ...
class VtbSubset(_Subset[VtbVector, VtbUnnormalizedVector]): ...
class VtbEncoder(_Encoder[VtbVector]): ...
class VectorDerivedTransformationBinding(_Architecture[VtbVector, VtbStorage, VtbEncoder]): ...
